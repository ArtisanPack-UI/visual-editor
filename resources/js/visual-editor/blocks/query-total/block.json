{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "artisanpack/query-total",
    "title": "Query Total",
    "category": "theme",
    "ancestor": [ "artisanpack/query" ],
    "description": "Display the total number of results in a query, or the range of results on the current page.",
    "textdomain": "artisanpack-visual-editor",
    "attributes": {
        "displayType": {
            "type": "string",
            "enum": [ "total-results", "range-display" ],
            "default": "total-results"
        },
        "prefix": {
            "type": "string",
            "default": ""
        },
        "singular": {
            "type": "string",
            "default": "result"
        },
        "plural": {
            "type": "string",
            "default": "results"
        },
        "suffix": {
            "type": "string",
            "default": ""
        }
    },
    "usesContext": [
        "query",
        "artisanpack/queryPreview"
    ],
    "supports": {
        "position": true,
        "artisanpackAnimations": true,
        "anchor": true,
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "color": {
            "gradients": true,
            "__experimentalDefaultControls": {
                "background": true,
                "text": true
            }
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontFamily": true,
            "__experimentalFontStyle": true,
            "__experimentalFontWeight": true,
            "__experimentalLetterSpacing": true,
            "__experimentalTextTransform": true,
            "__experimentalTextDecoration": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        },
        "interactivity": {
            "clientNavigation": true
        },
        "__experimentalBorder": {
            "radius": true,
            "color": true,
            "width": true,
            "style": true,
            "__experimentalDefaultControls": {
                "radius": true,
                "color": true,
                "width": true,
                "style": true
            }
        }
    }
}
