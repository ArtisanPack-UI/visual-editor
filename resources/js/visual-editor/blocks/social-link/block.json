{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "artisanpack/social-link",
    "title": "Social Icon",
    "category": "widgets",
    "parent": ["artisanpack/social-links"],
    "description": "Display an icon linking to a social profile or site.",
    "textdomain": "artisanpack-visual-editor",
    "attributes": {
        "url": {
            "type": "string",
            "role": "content"
        },
        "service": {
            "type": "string"
        },
        "label": {
            "type": "string",
            "role": "content"
        },
        "rel": {
            "type": "string"
        }
    },
    "usesContext": [
        "artisanpack/socialLinksOpenInNewTab",
        "artisanpack/socialLinksShowLabels"
    ],
    "supports": {
        "anchor": true,
        "reusable": false,
        "html": false,
        "interactivity": {
            "clientNavigation": true
        }
    }
}
